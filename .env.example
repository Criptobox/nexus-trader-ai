# ─────────────────────────────────────────────────────────────
# NEXUS Trader AI — Variables de entorno
# Copia este archivo a .env y ajusta los valores
# ─────────────────────────────────────────────────────────────

# Base de datos (SQLite local)
DATABASE_URL="file:./db/custom.db"

# 🔐 SECRETO MAESTRO — usado para derivar la clave AES-256-GCM del vault.
# Genera uno único con: openssl rand -hex 32
# NUNCA lo subas a GitHub. Si lo cambias, las claves guardadas dejan de descifrarse.
NEXUS_MASTER_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Capital inicial de la cuenta paper (USDT)
NEXUS_PAPER_START=10000

# Fuente de mercado: "binance" (por defecto, con fallback demo si no hay red)
# o "demo" para forzar datos sintéticos deterministas
# NEXUS_MARKET_SOURCE=demo

# ── Opcional: proveedor OpenAI-compatible para el router multi-modelo ──
# Si lo defines, los perfiles "openai-compatible" del router podrán usarse.
# NEXUS_OPENAI_BASE_URL=https://api.openai.com/v1
# NEXUS_OPENAI_API_KEY=
